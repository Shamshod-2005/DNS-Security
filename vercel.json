{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://brooks-times-might-exclusive.trycloudflare.com/api/:path*"
    },
    {
      "source": "/login",
      "destination": "https://brooks-times-might-exclusive.trycloudflare.com/login"
    },
    {
      "source": "/logout",
      "destination": "https://brooks-times-might-exclusive.trycloudflare.com/logout"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
